index 0000000..f5a37a6
--- /dev/null
+++ b/src/veritas/research/parent_child_r98/shrinking_layout.py
@@ -0,0 +1,316 @@
+"""Bounded vertex-balanced packet layouts with checked child shrinkage.
+
+These are finite scaled constructions, not the source's universal packer.
+The vertex strategy admits connected networks by balancing the two sides
+independently; a separate component-preserving specialization is retained.
+Both refuse unsatisfied per-side loads and use the X/Y half-edge geometry
+consumed by the ordinary child constructor.
+"""
+
+from veritas.research.eth_packing_v26.geometry_audit import (
+    audit_sparse_packet_geometry,
+)
+from veritas.research.eth_packing_v26.implicit import SPARSE_MODE_SCHEMA
+
+from .model import PacketLayout, Refusal, Semantics, canonical
+from .packing import audit_layout
+
+STRATEGY = "balanced_components"
+VERTEX_STRATEGY = "balanced_vertices"
+
+
+def audit_vertex_shrinking_layout(parent, layout):
+    """Audit actual side loads without assuming components stay in one group."""
+    if parent.semantics is not Semantics.FINITE_SCALED_EXPERIMENT:
+        raise ValueError("vertex shrinking layouts require finite scaled semantics")
+    if (layout.strategy, layout.a, layout.u) != (VERTEX_STRATEGY, 1, 1):
+        raise ValueError("unsupported vertex shrinking layout")
+    report = audit_layout(parent, layout)
+    source = layout.source
+    geometry = audit_sparse_packet_geometry(source)
+    if not geometry.get("valid"):
+        raise ValueError(
+            "independent shrinking geometry: " + geometry.get("reason", "refused")
+        )
+    coordinate = geometry["coordinates"][0]
+    if (
+        not report["group_load_bound_met"]
+        or not coordinate["per_side_port_bound"]
+        or not coordinate["per_child_six_M_over_r"]
+    ):
+        raise Refusal(
+            "INCONCLUSIVE_SHRINKING_LAYOUT", "actual vertex group load bound failed"
+        )
+    counts = {}
+    for packet in source["packets"]:
+        pair = tuple(packet["symbol_pairs"][0])
+        if len(packet["occupied_slots"]) != 1:
+            raise ValueError("vertex shrinking packet must contain one real edge")
+        if packet["index"] != counts.get(pair, 0):
+            raise ValueError("noncanonical vertex packet index")
+        counts[pair] = counts.get(pair, 0) + 1
+    required = max(
+        (count * (2 if pair[0] == pair[1] else 1) for pair, count in counts.items()),
+        default=0,
+    )
+    height = 2 * ((required + 1) // 2)
+    if source["H_pad"] != height:
+        raise ValueError("vertex packet padding differs from actual pattern occupancy")
+    child_edges = tuple(
+        group["predicted_child_wires"] for group in coordinate["groups"]
+    )
+    if sum(child_edges) != 2 * parent.edge_count or any(
+        64 * n > 6 * parent.edge_count for n in child_edges
+    ):
+        raise ValueError("vertex child half-edge count mismatch")
+    return {
+        **report,
+        "status": "PASS_FINITE_SHRINKING_LAYOUT",
+        "strategy": VERTEX_STRATEGY,
+        "vertex_assignment_verified": True,
+        "child_edge_counts": child_edges,
+        "largest_child_edges": max(child_edges, default=0),
+        "all_child_six_M_over_r": True,
+        "strict_shrink": all(n < parent.edge_count for n in child_edges),
+        "source_qualified": False,
+        "universal_packer_proved": False,
+    }
+
+
+def construct_vertex_shrinking_layout(parent, *, budget):
+    """Balance whole vertices independently on the two sides.
+
+    Connected components may span groups. Each side uses deterministic first
+    fit by decreasing vertex degree, with capacity floor(3M/64). This is a
+    bounded sufficient construction and refuses any unplaceable vertex.
+    """
+    if parent.semantics is not Semantics.FINITE_SCALED_EXPERIMENT:
+        raise ValueError("vertex shrinking layouts require finite scaled semantics")
+    M = parent.edge_count
+    if not 1 <= M <= budget.policy.max_edges:
+        raise Refusal("INCONCLUSIVE_RESOURCE_LIMIT", "shrinking layout parent edge cap")
+    capacity = 3 * M // 64
+    if capacity == 0:
+        raise Refusal(
+            "INCONCLUSIVE_SHRINKING_LAYOUT",
+            "nonempty vertex cannot meet the per-side bound",
+        )
+    labels = {"row": {}, "column": {}}
+    for side, side_labels in labels.items():
+        loads = [0] * 64
+        vertices = sorted(
+            (v for v in parent.vertices if v.side == side and v.ports),
+            key=lambda v: (-len(v.ports), v.vertex_id),
+        )
+        for vertex in vertices:
+            degree = len(vertex.ports)
+            if degree > capacity:
+                raise Refusal(
+                    "INCONCLUSIVE_SHRINKING_LAYOUT",
+                    "vertex degree exceeds the per-side group capacity",
+                )
+            group = next(
+                (g for g, load in enumerate(loads) if load + degree <= capacity), None
+            )
+            if group is None:
+                raise Refusal(
+                    "INCONCLUSIVE_SHRINKING_LAYOUT",
+                    "vertex first-fit exhausted 64 groups",
+                )
+            side_labels[str(vertex.vertex_id)] = [group]
+            loads[group] += degree
+            budget.tick(degree + 64)
+    edges, counts, packets = parent.bipartite_edges(), {}, []
+    for edge, (row, column) in enumerate(edges):
+        rg, cg = labels["row"][str(row)][0], labels["column"][str(column)][0]
+        pair = min(rg, cg), max(rg, cg)
+        index = counts.get(pair, 0)
+        packets.append(
+            {
+                "symbol_pairs": [list(pair)],
+                "index": index,
+                "occupied_slots": [[int(rg > cg), edge]],
+            }
+        )
+        counts[pair] = index + 1
+    required = max(
+        count * (2 if pair[0] == pair[1] else 1) for pair, count in counts.items()
+    )
+    source = {
+        "schema": SPARSE_MODE_SCHEMA,
+        "claim": "FINITE_NONEMPTY_PACKET_VIEW_SPARSE_SLOTS",
+        "r": 64,
+        "a": 1,
+        "L": 2,
+        "D": 4096,
+        "M": M,
+        "H_pad": 2 * ((required + 1) // 2),
+        "edges": [list(edge) for edge in edges],
+        "row_labels": labels["row"],
+        "column_labels": labels["column"],
+        "packets": sorted(packets, key=lambda p: (p["symbol_pairs"], p["index"])),
+    }
+    layout = PacketLayout(
+        parent.content_digest, 1, 1, canonical(source), VERTEX_STRATEGY
+    )
+    audit_vertex_shrinking_layout(parent, layout)
+    return layout
+
+
+def _edge_components(parent, budget):
+    """Union edges sharing either endpoint; isolated scalars have no edge load."""
+    roots = list(range(parent.edge_count))
+
+    def find(edge):
+        while roots[edge] != edge:
+            roots[edge] = roots[roots[edge]]
+            edge = roots[edge]
+        return edge
+
+    for vertex in parent.vertices:
+        budget.tick(len(vertex.ports) + 1)
+        if vertex.ports:
+            head = find(vertex.ports[0])
+            for edge in vertex.ports[1:]:
+                other = find(edge)
+                roots[other] = head
+    components = {}
+    for edge in range(parent.edge_count):
+        components.setdefault(find(edge), []).append(edge)
+    return sorted(components.values(), key=lambda es: (-len(es), es[0]))
+
+
+def audit_shrinking_layout(parent, layout):
+    """Independently count actual ports and enforce the finite shrink premise.
+
+    No component assignment or packet construction is replayed here. The two
+    independent geometry auditors inspect the submitted endpoints and slots.
+    Whole-component ownership follows because both ends of every edge carry
+    the same group label.
+    """
+    if parent.semantics is not Semantics.FINITE_SCALED_EXPERIMENT:
+        raise ValueError("component shrinking layouts require finite scaled semantics")
+    if (layout.strategy, layout.a, layout.u) != (STRATEGY, 1, 1):
+        raise ValueError("unsupported component shrinking layout")
+    report = audit_layout(parent, layout)
+    source = layout.source
+    geometry = audit_sparse_packet_geometry(source)
+    if not geometry.get("valid"):
+        raise ValueError(
+            "independent shrinking geometry: " + geometry.get("reason", "refused")
+        )
+    if not report["group_load_bound_met"] or not all(
+        c["per_side_port_bound"] and c["per_child_six_M_over_r"]
+        for c in geometry["coordinates"]
+    ):
+        raise Refusal(
+            "INCONCLUSIVE_SHRINKING_LAYOUT", "actual component group load bound failed"
+        )
+
+    counts = [0] * 64
+    for packet in source["packets"]:
+        pair = packet["symbol_pairs"][0]
+        if pair[0] != pair[1] or len(packet["occupied_slots"]) != 1:
+            raise ValueError("component packet must have one same-group edge")
+        if packet["occupied_slots"][0][0] != 0:
+            raise ValueError("component packet must use slot zero")
+        group = pair[0]
+        if packet["index"] != counts[group]:
+            raise ValueError("noncanonical component packet index")
+        counts[group] += 1
+    if source["H_pad"] != 2 * max(counts, default=0):
+        raise ValueError("component padding differs from actual group occupancy")
+    child_edges = tuple(2 * count for count in counts)
+    if sum(child_edges) != 2 * parent.edge_count or any(
+        64 * edges > 6 * parent.edge_count for edges in child_edges
+    ):
+        raise ValueError("component child half-edge count mismatch")
+    return {
+        **report,
+        "status": "PASS_FINITE_SHRINKING_LAYOUT",
+        "strategy": STRATEGY,
+        "component_assignment_verified": True,
+        "child_edge_counts": child_edges,
+        "largest_child_edges": max(child_edges, default=0),
+        "all_child_six_M_over_r": True,
+        "strict_shrink": all(edges < parent.edge_count for edges in child_edges),
+        "source_qualified": False,
+        "universal_packer_proved": False,
+    }
+
+
+def construct_shrinking_layout(parent, *, budget):
+    """First-fit whole components into 64 bins of capacity floor(3M/64).
+
+    At each group both side loads equal its original edge count. The generated
+    child therefore has twice that many edges and satisfies 64*M_child<=6*M.
+    First fit fills lower-numbered groups before opening another one; spreading
+    tiny components uniformly is unnecessary and can defeat a second active
+    shrinking level in bounded examples.
+    """
+    if parent.semantics is not Semantics.FINITE_SCALED_EXPERIMENT:
+        raise ValueError("component shrinking layouts require finite scaled semantics")
+    M = parent.edge_count
+    if not 1 <= M <= budget.policy.max_edges:
+        raise Refusal("INCONCLUSIVE_RESOURCE_LIMIT", "shrinking layout parent edge cap")
+    capacity = 3 * M // 64
+    if capacity == 0:
+        raise Refusal(
+            "INCONCLUSIVE_SHRINKING_LAYOUT",
+            "nonempty same-group component cannot meet the per-side bound",
+        )
+    assignments, loads = {}, [0] * 64
+    for component in _edge_components(parent, budget):
+        if len(component) > capacity:
+            raise Refusal(
+                "INCONCLUSIVE_SHRINKING_LAYOUT",
+                "connected component exceeds the component-preserving group capacity",
+            )
+        group = next(
+            (g for g, load in enumerate(loads) if load + len(component) <= capacity),
+            None,
+        )
+        if group is None:
+            raise Refusal(
+                "INCONCLUSIVE_SHRINKING_LAYOUT",
+                "component first-fit exhausted 64 groups",
+            )
+        loads[group] += len(component)
+        assignments.update((edge, group) for edge in component)
+        budget.tick(len(component) + 64)
+
+    edges = parent.bipartite_edges()
+    row_labels, column_labels = {}, {}
+    indices, packets = [0] * 64, []
+    for edge, (row, column) in enumerate(edges):
+        group = assignments[edge]
+        for labels, vertex in ((row_labels, row), (column_labels, column)):
+            previous = labels.setdefault(str(vertex), [group])
+            if previous != [group]:
+                raise ValueError("component assignment split a vertex")
+        packets.append(
+            {
+                "symbol_pairs": [[group, group]],
+                "index": indices[group],
+                "occupied_slots": [[0, edge]],
+            }
+        )
+        indices[group] += 1
+    packets.sort(key=lambda p: (p["symbol_pairs"][0][0], p["index"]))
+    source = {
+        "schema": SPARSE_MODE_SCHEMA,
+        "claim": "FINITE_NONEMPTY_PACKET_VIEW_SPARSE_SLOTS",
+        "r": 64,
+        "a": 1,
+        "L": 2,
+        "D": 4096,
+        "M": M,
+        "H_pad": 2 * max(loads),
+        "edges": [list(edge) for edge in edges],
+        "row_labels": row_labels,
+        "column_labels": column_labels,
+        "packets": packets,
+    }
+    layout = PacketLayout(parent.content_digest, 1, 1, canonical(source), STRATEGY)
+    audit_shrinking_layout(parent, layout)
+    return layout
diff --git a/src/veritas/research/parent_child_r98/shrinking_oracle.py b/src/veritas/research/parent_child_r98/shrinking_oracle.py
new file mode 100644
index 0000000..e8ef993
--- /dev/null
+++ b/src/veritas/research/parent_child_r98/shrinking_oracle.py
@@ -0,0 +1,369 @@
+"""Independent coefficient elimination and a constant-deformation certificate.
+
+No production child constructor or packet-entry evaluator is imported.  Formal
+coefficients are extracted from the original parent half-edge factors.  The
+componentwise exponent cutoff computes one coefficient exactly; it never
+changes the caller's complete weighted tuple domain.
+"""
+
+from itertools import product
+
+from veritas.research.independent_r82.point_mode_oracle import (
+    _evaluate_shifted,
+    _IndependentExtension,
+    _Meter,
+    shifted_cauchy_polynomial,
+)
+from veritas.research.independent_r95.recipe_oracle import ReferenceArithmetic, _entry
+
+from .model import Refusal
+
+
+def _arithmetic(parent, precision, budget):
+    return ReferenceArithmetic(
+        precision,
+        parent.defining_polynomial,
+        1,
+        budget.policy.max_work - budget.work,
+        max_precision_bits=budget.policy.max_precision,
+    )
+
+
+def _scope_check(ports, budget):
+    if len(ports) > budget.policy.max_factor_bits:
+        raise Refusal("INCONCLUSIVE_RESOURCE_LIMIT", "independent factor width cap")
+
+
+def eliminate_factors(factors, arithmetic, *, budget):
+    """Eliminate each connected Boolean component before multiplying results.
+
+    Factor values may belong to the reference ring or to the truncated sparse
+    polynomial semiring below. Components are formed from factor scopes, never
+    from the production child partition. Min-scope searches therefore stay
+    local on disconnected fixtures instead of scanning the whole graph for
+    every eliminated variable.
+    """
+    factors = list(factors)
+    representatives = {}
+
+    def find(x):
+        representatives.setdefault(x, x)
+        root = x
+        while representatives[root] != root:
+            root = representatives[root]
+        while representatives[x] != x:
+            nxt = representatives[x]
+            representatives[x] = root
+            x = nxt
+        return root
+
+    for ports, _ in factors:
+        _scope_check(ports, budget)
+        if len(set(ports)) != len(ports):
+            raise ValueError("duplicate variable in independent factor")
+        for edge in ports:
+            root, other = find(ports[0]), find(edge)
+            representatives[max(root, other)] = min(root, other)
+            budget.tick()
+    components = {}
+    result = arithmetic.one
+    for ports, table in factors:
+        if ports:
+            components.setdefault(find(ports[0]), []).append((ports, table))
+        else:
+            result = arithmetic.mul(result, table[()])
+
+    for component in sorted(components):
+        current = components[component]
+        while any(ports for ports, _ in current):
+            incident = {}
+            for index, (ports, _) in enumerate(current):
+                for edge in ports:
+                    incident.setdefault(edge, []).append(index)
+                    budget.tick()
+            scopes = {
+                edge: set().union(*(set(current[j][0]) for j in indices))
+                for edge, indices in incident.items()
+            }
+            edge = min(incident, key=lambda e: (len(scopes[e]), e))
+            remaining = tuple(sorted(scopes[edge] - {edge}))
+            _scope_check(remaining, budget)
+            selected = set(incident[edge])
+            joined = [factor for j, factor in enumerate(current) if j in selected]
+            current = [factor for j, factor in enumerate(current) if j not in selected]
+            table = {}
+            for bits in product((0, 1), repeat=len(remaining)):
+                budget.tick()
+                assignment = dict(zip(remaining, bits))
+                total = arithmetic.zero
+                for bit in (0, 1):
+                    assignment[edge] = bit
+                    term = arithmetic.one
+                    for ports, entries in joined:
+                        term = arithmetic.mul(
+                            term, entries[tuple(assignment[e] for e in ports)]
+                        )
+                    total = arithmetic.add(total, term)
+                table[bits] = total
+            current.append((remaining, table))
+        for _, table in current:
+            result = arithmetic.mul(result, table[()])
+    return result
+
+
+def _vertex_factors(parent, arithmetic, budget, *, half_edges=False):
+    factors = []
+    for vertex in parent.vertices:
+        ports = tuple(
+            edge + (parent.edge_count if half_edges and vertex.side == "column" else 0)
+            for edge in vertex.ports
+        )
+        _scope_check(ports, budget)
+        table = {}
+        for bits in product((0, 1), repeat=len(ports)):
+            budget.tick()
+            table[bits] = _entry(vertex.tensor, bits, arithmetic)
+        factors.append((ports, table))
+    return factors
+
+
+def contract_independent(parent, budget):
+    """Original contraction via independent entry semantics and components."""
+    ar = _arithmetic(parent, parent.precision, budget)
+    result = eliminate_factors(_vertex_factors(parent, ar, budget), ar, budget=budget)
+    budget.tick(ar.used)
+    return result
+
+
+def parent_point(parent, layout, modes, *, budget):
+    """Direct half-edge Cauchy deformation, independent of mode factorization."""
+    if (
+        layout.parent_digest != parent.content_digest
+        or modes.layout_digest != layout.content_digest
+    ):
+        raise ValueError("independent point ancestry mismatch")
+    m, source = modes.certificate, layout.source
+    ar = _arithmetic(parent, m["precision"], budget)
+    meter = _Meter(
+        min(5_000_000, budget.policy.max_work - budget.work),
+        min(60, budget.policy.max_seconds),
+    )
+    scalar = _IndependentExtension(
+        m["precision"],
+        parent.defining_polynomial,
+        meter,
+        max_precision_bits=budget.policy.max_precision,
+    )
+    factors = _vertex_factors(parent, ar, budget, half_edges=True)
+    # Slot-pair coefficients repeat across packets; cache by actual slot pair,
+    # not by child/group data. Their independent rational derivation is shared.
+    coefficients = {}
+    for packet in source["packets"]:
+        real = packet["occupied_slots"]
+        columns = tuple(parent.edge_count + edge for _, edge in real)
+        _scope_check((0,) + columns, budget)
+        for x, row in real:
+            values = []
+            for y, _ in real:
+                if (x, y) not in coefficients:
+                    coefficients[x, y] = (
+                        _evaluate_shifted(
+                            scalar,
+                            shifted_cauchy_polynomial(
+                                source["L"],
+                                m["node"],
+                                2 * source["L"],
+                                x,
+                                y,
+                                meter=meter,
+                            ),
+                            tuple(m["zeta"]),
+                        ),
+                    )
+                values.append(coefficients[x, y])
+            table = {}
+            for bits in product((0, 1), repeat=1 + len(columns)):
+                budget.tick()
+                value = ar.zero
+                for bit, coefficient in zip(bits[1:], values):
+                    if bit:
+                        value = ar.add(value, coefficient)
+                table[bits] = value if bits[0] else ar.add(ar.one, ar.neg(value))
+            factors.append(((row, *columns), table))
+    result = eliminate_factors(factors, ar, budget=budget)
+    budget.tick(ar.used + meter.used)
+    return result
+
+
+class _CoefficientArithmetic:
+    """Reference-ring polynomials modulo (Z_j ** (beta_j + 1)) for every j."""
+
+    def __init__(self, arithmetic, beta, budget, max_terms):
+        if type(max_terms) is not int or not 1 <= max_terms <= 100_000:
+            raise ValueError("invalid independent polynomial term cap")
+        self.ar = arithmetic
+        self.beta = beta
+        self.budget = budget
+        self.max_terms = max_terms
+        self.origin = (0,) * len(beta)
+        self.zero = {}
+        self.one = {self.origin: arithmetic.one}
+
+    def constant(self, value):
+        return {} if value == self.ar.zero else {self.origin: value}
+
+    def _insert(self, result, exponent, coefficient):
+        value = self.ar.add(result.get(exponent, self.ar.zero), coefficient)
+        if value == self.ar.zero:
+            result.pop(exponent, None)
+        else:
+            result[exponent] = value
+        if len(result) > self.max_terms:
+            raise Refusal(
+                "INCONCLUSIVE_RESOURCE_LIMIT", "independent polynomial term cap"
+            )
+
+    def add(self, x, y):
+        result = dict(x)
+        for exponent, coefficient in y.items():
+            self.budget.tick()
+            self._insert(result, exponent, coefficient)
+        return result
+
+    def mul(self, x, y):
+        result = {}
+        for left, a in x.items():
+            for right, b in y.items():
+                self.budget.tick(1 + len(self.beta))
+                exponent = tuple(u + v for u, v in zip(left, right))
+                if all(u <= cap for u, cap in zip(exponent, self.beta)):
+                    self._insert(result, exponent, self.ar.mul(a, b))
+        return result
+
+
+def tuple_coefficient(parent, layout, modes, beta, *, budget, max_terms=10_000):
+    """Independent coefficient of a complete specified parent deformation term.
+
+    The caller independently validates the mode basis and weighted stream.
+    Here ancestry, coefficient index, point ring and weight membership are
+    checked again. No child graphs, child tensor recipes or child values enter
+    this calculation.
+    """
+    m = modes.certificate
+    if (
+        layout.parent_digest != parent.content_digest
+        or modes.layout_digest != layout.content_digest
+        or beta.modes_digest != modes.content_digest
+        or len(beta.values) != len(m["modes"])
+        or m["irreducible_polynomial"] != parent.defining_polynomial
+        or m["precision"] < parent.precision
+        or sum(n * mode["weight"] for n, mode in zip(beta.values, m["modes"]))
+        >= m["precision"]
+    ):
+        raise ValueError("independent coefficient binding or exponent mismatch")
+    ar = _arithmetic(parent, m["precision"], budget)
+    if sum(beta.values) > parent.edge_count:
+        # There are M affine row factors, so their total formal degree is <=M.
+        return ar.zero
+    poly = _CoefficientArithmetic(ar, beta.values, budget, max_terms)
+    factors = []
+    for vertex in parent.vertices:
+        ports = tuple(
+            edge + (parent.edge_count if vertex.side == "column" else 0)
+            for edge in vertex.ports
+        )
+        _scope_check(ports, budget)
+        table = {}
+        for bits in product((0, 1), repeat=len(ports)):
+            budget.tick()
+            table[bits] = poly.constant(_entry(vertex.tensor, bits, ar))
+        factors.append((ports, table))
+
+    local = [[] for _ in range(parent.edge_count)]
+    for row, column, value in m["local"]:
+        local[row].append((column, tuple(map(tuple, value))))
+    targets = [[] for _ in range(parent.edge_count)]
+    for j, mode in enumerate(m["modes"]):
+        if beta.values[j]:
+            exponent = tuple(int(k == j) for k in range(len(beta.values)))
+            for row, value in mode["rows"]:
+                targets[row].append((exponent, tuple(map(tuple, value))))
+
+    for row in range(parent.edge_count):
+        columns = tuple(sorted({column for column, _ in local[row]}))
+        ports = (row,) + tuple(parent.edge_count + column for column in columns)
+        _scope_check(ports, budget)
+        table = {}
+        for bits in product((0, 1), repeat=len(ports)):
+            budget.tick()
+            assignment = dict(zip(columns, bits[1:]))
+            constant = ar.zero
+            for column, coefficient in local[row]:
+                if assignment[column]:
+                    constant = ar.add(constant, coefficient)
+            if not bits[0]:
+                constant = ar.add(ar.one, ar.neg(constant))
+            value = poly.constant(constant)
+            for exponent, coefficient in targets[row]:
+                poly._insert(
+                    value, exponent, coefficient if bits[0] else ar.neg(coefficient)
+                )
+            table[bits] = value
+        factors.append((ports, table))
+
+    for exponent, mode in zip(beta.values, m["modes"]):
+        if not exponent:
+            # Includes the exponent-zero convention even when the source is 0.
+            continue
+        columns = tuple(sorted({column for column, _ in mode["column_terms"]}))
+        ports = tuple(parent.edge_count + column for column in columns)
+        _scope_check(ports, budget)
+        table = {}
+        for bits in product((0, 1), repeat=len(ports)):
+            budget.tick()
+            assignment = dict(zip(columns, bits))
+            scalar = sum(c * assignment[column] for column, c in mode["column_terms"])
+            table[bits] = poly.constant(ar.power(ar.scalar(scalar), exponent))
+        factors.append((ports, table))
+
+    result = eliminate_factors(factors, poly, budget=budget).get(beta.values, ar.zero)
+    budget.tick(ar.used)
+    return result
+
+
+def certify_constant_deformation(parent, *, budget):
+    """Certify degree zero by independently checking every row tensor entry.
+
+    A row tensor constant in all its Y bits factors out of the Y summation.
+    For each edge, the two Boolean affine factors sum to one, as an exact
+    polynomial identity, so the complete deformation is independent of T.
+    Entries are reduced at their creation precision before comparison. The
+    certificate binds the parent and reports no contraction result.
+    """
+    ar = _arithmetic(parent, parent.precision, budget)
+    rows = entries = 0
+    for vertex in parent.vertices:
+        if vertex.side != "row":
+            continue
+        _scope_check(vertex.ports, budget)
+        baseline = None
+        for bits in product((0, 1), repeat=len(vertex.ports)):
+            budget.tick()
+            value = _entry(vertex.tensor, bits, ar)
+            if baseline is None:
+                baseline = value
+            elif value != baseline:
+                raise ValueError("row tensor is not constant in its inherited bits")
+            entries += 1
+        rows += 1
+    budget.tick(ar.used)
+    return {
+        "status": "PASS_CONSTANT_DEFORMATION_DEGREE_BOUND",
+        "parent_digest": parent.content_digest,
+        "degree_bound": 0,
+        "row_tensors_checked": rows,
+        "row_entries_checked": entries,
+        "creation_precision_inheritance": True,
+        "proof_rule": "SUM_Y_OF_BOOLEAN_AFFINE_FACTOR_IS_ONE",
+        "source_qualified": False,
+    }
